# Local-only config. Copy this file to .env.local and edit your real URLs/tokens.

JCORE_GATEWAY_HOST=127.0.0.1
JCORE_GATEWAY_PORT=8787

# Open an unhealthy AI upstream circuit after this many consecutive failures,
# then allow a half-open retry after the cooldown.
JCORE_CIRCUIT_FAILURE_THRESHOLD=3
JCORE_CIRCUIT_OPEN_MS=30000
# Temporary authenticated browser session used only for the proxied 9Router UI.
JCORE_DASHBOARD_SESSION_TTL_MS=1800000

# Required whenever JCORE_GATEWAY_HOST is not localhost.
# Browser requests must send: Authorization: Bearer <token>
JCORE_GATEWAY_TOKEN=

# Comma-separated browser origins. Do not include a path such as /jarvis.
JCORE_CORS_ORIGIN=http://127.0.0.1:5173,https://jarvis.huykl.id.vn,https://huyhoangcva90-lab.github.io

HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_HEALTH_URL=http://127.0.0.1:8642/v1/models
HERMES_CHAT_URL=http://127.0.0.1:8642/v1/chat/completions
# Must match Hermes API_SERVER_KEY. Required for session continuation headers.
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# The main web chat always uses this Hermes profile.
HERMES_DEFAULT_PROFILE=jarvis
# Comma-separated allowlist. Profile names are never accepted outside this list.
HERMES_ALLOWED_PROFILES=jarvis,cadence-content,code-architect,security-auditor
# Keep false when port 8642 is dedicated to the active `jarvis` profile.
# Set true only when Hermes gateway.multiplex_profiles is enabled.
HERMES_MULTIPLEX_PROFILES=false

# Persistent web conversation (Telegram-like session behavior).
HERMES_SESSION_MODE=web
HERMES_SESSION_ID=jarvis-web-primary
HERMES_SESSION_KEY=agent:jarvis:web:dm:owner
# To continue the exact Telegram transcript, set MODE=telegram and replace the
# two values above with the session ID/key reported by Hermes for that chat/topic.

OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/v1/models
# The OpenAI-compatible endpoint is disabled by default in OpenClaw.
OPENCLAW_CHAT_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_MODEL=openclaw/default
OPENCLAW_TASK_URL=
OPENCLAW_API_KEY=

NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_HEALTH_URL=http://127.0.0.1:20128/v1/models
NINEROUTER_CHAT_URL=http://127.0.0.1:20128/v1/chat/completions
NINEROUTER_API_KEY=
# Default combo exposed by the local n9router dashboard.
NINEROUTER_MODEL=Code
# Keep the native dashboard bound to loopback. J-Core proxies it only after
# authenticating the Jarvis device token.

# Claude Code does not expose HTTP by default. Only point these values at a
# local authenticated bridge that you intentionally run.
CLAUDE_BASE_URL=http://127.0.0.1:3001
CLAUDE_HEALTH_URL=http://127.0.0.1:3001/health
CLAUDE_CHAT_URL=
CLAUDE_API_KEY=
