# Local-only config. Copy this file to .env.local and edit your real URLs/tokens.

JCORE_GATEWAY_HOST=127.0.0.1
JCORE_GATEWAY_PORT=8787

# Optional. If set, browser requests must send: Authorization: Bearer <token>
JCORE_GATEWAY_TOKEN=

# For local Vite dev use http://127.0.0.1:5173.
# For Vercel/tunnel, change this to your real web origin.
JCORE_CORS_ORIGIN=http://127.0.0.1:5173

HERMES_BASE_URL=http://127.0.0.1:8080
HERMES_HEALTH_URL=http://127.0.0.1:8080/health
# Example: http://127.0.0.1:8080/api/chat
HERMES_CHAT_URL=
HERMES_API_KEY=

OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/health
# Example: http://127.0.0.1:18789/api/tasks
OPENCLAW_TASK_URL=
OPENCLAW_API_KEY=

NINEROUTER_BASE_URL=http://127.0.0.1:9000
NINEROUTER_HEALTH_URL=http://127.0.0.1:9000/health
# Example: http://127.0.0.1:9000/v1/chat/completions
NINEROUTER_CHAT_URL=
NINEROUTER_API_KEY=
