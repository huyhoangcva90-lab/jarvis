# JARVIS server config. Copy this file to .env.local on the Ubuntu AI
# WORKSTATION and edit real local URLs/secrets there. Do not copy workstation
# secrets into the frontend or the development machine.

JCORE_GATEWAY_HOST=127.0.0.1
JCORE_GATEWAY_PORT=8787
JCORE_WEB_ROOT=/home/<ubuntu-user>/.local/share/j-core-console/dist

# Optional public origin used by documentation and operator checks. Cloudflare
# Tunnel should route this hostname to the loopback JARVIS listener above.
JCORE_PUBLIC_ORIGIN=https://jarvis.example.com

# One local login protects the UI and all same-origin service routes. The
# browser receives only an HttpOnly session cookie; URL/token fields disappear.
JCORE_AUTH_USERNAME=admin
JCORE_AUTH_PASSWORD=change-this-password
JCORE_AUTH_SESSION_TTL_MS=604800000

# Open an unhealthy AI upstream circuit after this many consecutive failures,
# then allow a half-open retry after the cooldown.
JCORE_CIRCUIT_FAILURE_THRESHOLD=3
JCORE_CIRCUIT_OPEN_MS=30000
# Temporary authenticated browser session used only for the proxied 9Router UI.
JCORE_DASHBOARD_SESSION_TTL_MS=1800000

# Ubuntu workspace broker. Browser paths are always relative to these roots;
# absolute server paths are never returned by the API. Writes remain opt-in.
JCORE_WORKSPACE_ROOT=/srv/j-core
JCORE_OBSIDIAN_ROOT=/home/<ubuntu-user>/Documents/ObsidianVault
JCORE_WORKSPACE_WRITE_ENABLED=true

# Controlled, authenticated config editors shown inside each app dashboard.
JCORE_APP_CONFIG_WRITE_ENABLED=true
# If a real app config path is absent, J-Core creates an editable managed file
# under JCORE_CONFIG_ROOT so every dashboard works immediately.
JCORE_CONFIG_ROOT=/home/<ubuntu-user>/.local/share/j-core-console/.jcore/apps
JCORE_HERMES_CONFIG_PATH=/home/<ubuntu-user>/.config/hermes/config.yaml
JCORE_OPENCLAW_CONFIG_PATH=/home/<ubuntu-user>/.config/openclaw/config.json
JCORE_9ROUTER_CONFIG_PATH=/home/<ubuntu-user>/.config/9router/config.json
JCORE_CLAUDE_CONFIG_PATH=/home/<ubuntu-user>/.claude/settings.json

# Safe command broker. This does not accept arbitrary shell syntax or write,
# delete, restart and stop actions.
JCORE_TERMINAL_ENABLED=true
JCORE_TERMINAL_PRIVATE_MODE=false
JCORE_TERMINAL_SHELL=/bin/bash
JCORE_TERMINAL_TIMEOUT_MS=10000
JCORE_TERMINAL_OUTPUT_LIMIT=262144
JCORE_TERMINAL_SESSION_TTL_MS=1800000
JCORE_TERMINAL_TICKET_TTL_MS=60000
JCORE_MANAGED_SERVICES=j-core-gateway,hermes,openclaw,9router
JCORE_HERMES_CLI=jarvis
JCORE_OPENCLAW_CLI=openclaw
JCORE_CLAUDE_CLI=claude

# Same-origin production does not require CORS. Set this only for explicit
# development cross-origin testing, e.g. http://127.0.0.1:5173.
JCORE_CORS_ORIGIN=

# Native dashboard proxies are optional authenticated helpers and should remain
# loopback-only. Do not publish these ports through Cloudflare or a firewall.
JCORE_NATIVE_DASHBOARD_PROXY_HOST=127.0.0.1

HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_HEALTH_URL=http://127.0.0.1:8642/v1/models
HERMES_CHAT_URL=http://127.0.0.1:8642/v1/chat/completions
# Must match Hermes API_SERVER_KEY. Required for session continuation headers.
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# The main web chat always uses this Hermes profile.
HERMES_DEFAULT_PROFILE=jarvis
# Allow the Jarvis orchestrator and the isolated E.V personal profile.
HERMES_ALLOWED_PROFILES=jarvis,ev-personal
# This must match `gateway.multiplex_profiles: true` in Hermes config.yaml.
HERMES_MULTIPLEX_PROFILES=true
# Optional JSON array/object used when Hermes does not expose /v1/profiles.
# HERMES_PROFILE_METADATA_JSON=[{"id":"jarvis","palette":"orange","tags":["Memory"]}]
HERMES_PROFILE_METADATA_TTL_MS=30000

# Persistent web conversation (Telegram-like session behavior).
HERMES_SESSION_MODE=web
HERMES_SESSION_ID=jarvis-web-primary
HERMES_SESSION_KEY=agent:jarvis:web:dm:owner

# Optional OpenAI-compatible local Whisper/TTS endpoints. When empty, J-Core
# automatically keeps using browser SpeechRecognition + speechSynthesis.
HERMES_STT_URL=
HERMES_STT_API_KEY=
HERMES_STT_MODEL=whisper-1
HERMES_TTS_URL=
HERMES_TTS_API_KEY=
HERMES_TTS_MODEL=tts-1
HERMES_TTS_VOICE=alloy
# To continue the exact Telegram transcript, set MODE=telegram and replace the
# two values above with the session ID/key reported by Hermes for that chat/topic.

OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/v1/models
# The OpenAI-compatible endpoint is disabled by default in OpenClaw.
OPENCLAW_CHAT_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_MODEL=openclaw/default
# Agents that the authenticated JARVIS web chat may target. Each agent receives
# a stable server-owned session key; the key is never accepted from the browser.
OPENCLAW_WEB_AGENTS=main,soul,mind,power,reality,time,space
OPENCLAW_TASK_URL=
OPENCLAW_API_KEY=

NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_HEALTH_URL=http://127.0.0.1:20128/v1/models
NINEROUTER_CHAT_URL=http://127.0.0.1:20128/v1/chat/completions
NINEROUTER_API_KEY=
# Default combo exposed by the local n9router dashboard.
NINEROUTER_MODEL=Code
# Keep 9Router bound to loopback. JARVIS proxies approved routes only after
# authenticating the server-side session.

# Claude Code does not expose HTTP by default. Only point these values at a
# local authenticated bridge that you intentionally run.
CLAUDE_BASE_URL=http://127.0.0.1:3001
CLAUDE_HEALTH_URL=http://127.0.0.1:3001/health
CLAUDE_CHAT_URL=
CLAUDE_API_KEY=
